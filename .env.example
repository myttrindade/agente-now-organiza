# Chave da Groq (https://console.groq.com/keys) — usada pelo LLM do agente.
GROQ_API_KEY=sua-chave-aqui

# Endereço do servidor MCP do mytek-hub (Now Organiza).
# Local: http://localhost:3000/api/mcp
# Produção: https://<seu-dominio>/api/mcp
MYTEK_HUB_MCP_URL=http://localhost:3000/api/mcp

# Token pessoal gerado em /conta/ia no mytek-hub.
MYTEK_HUB_MCP_TOKEN=
